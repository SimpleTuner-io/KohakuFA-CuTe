@@ -0,0 +1,31 @@
+"""One-factor FP32 maximum-prefetch control using the shared backward methods."""
+
+import math
+from dataclasses import asdict
+from functools import lru_cache
+
+
+def make_attention(*, stage_maximum=False):
+    if not isinstance(stage_maximum, bool):
+        raise ValueError("Select maximum staging with an explicit boolean.")
+    import torch
+
+    from kohakufa_cute import api, fa4_sm80, native
+    from kohakufa_cute.fa4_sm80 import _sm120
+
+    if not _sm120.target_device(torch.device("cuda", torch.cuda.current_device())) or not fa4_sm80.available():
+        raise ValueError("The maximum pipeline experiment requires the qualified full RTX 5090 runtime.")
+
+    @lru_cache(maxsize=4)
+    def runner(dimension, causal):
+        return native.extension().AttentionRunner(
+            "warp-max" if stage_maximum else "warp", asdict(_sm120.schedule(dimension, causal))
+        )
+
+    def run(q, k, v, *, is_causal=False, scale=None, enable_gqa=False):
+        amount = q.shape[-1] ** -0.5 if scale is None else scale
+        if not isinstance(amount, (float, int)) or not math.isfinite(amount) or amount < torch.finfo(torch.float32).tiny:
+            return api._extension().sdpa(q, k, v, None, 0.0, is_causal, scale, enable_gqa)
+        return runner(q.shape[-1], is_causal)(q, k, v, causal=is_causal, scale=scale)
+
+    return run
